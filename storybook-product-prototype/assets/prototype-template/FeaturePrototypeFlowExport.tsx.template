import { useEffect, useMemo, useState } from "react";

import {
  getPrototypeFlowLayoutStorageKey,
  readPrototypeFlowLayoutPositions,
  type PrototypeFlowLayoutPositions,
} from "../prototypeFlowLayout";
import "./__FEATURE_KEBAB__.css";
import { __FEATURE_PASCAL__ } from "./__FEATURE_PASCAL__";
import {
  __FEATURE_CAMEL__FlowNodes,
  __FEATURE_CAMEL__Routes,
  __FEATURE_CAMEL__Transitions,
  type __FEATURE_PASCAL__FlowNode,
  type __FEATURE_PASCAL__FlowTargetId,
  type __FEATURE_PASCAL__Route,
  type __FEATURE_PASCAL__Transition,
} from "./__FEATURE_CAMEL__Flow";
import { __FEATURE_CAMEL__Meta } from "./__FEATURE_CAMEL__Meta";

const routePreviewWidth = 375;
const routeHeaderHeight = 64;
const routePreviewHeight = 812;
const routeFrameSize = 2;
const routeWidth = routePreviewWidth + routeFrameSize;
const routeHeight = routeHeaderHeight + routePreviewHeight + routeFrameSize;
const decisionNodeSize = 220;
const stateNodeWidth = 308;
const stateNodeHeight = 124;
const padding = 96;
const flowArrowLength = 14;
const flowArrowHalfWidth = 5;
const flowEdgeColorVariants = [
  "primary",
  "secondary",
  "tertiary",
  "quaternary",
] as const;
const flowExportNodeIds = new Set<__FEATURE_PASCAL__FlowTargetId>([
  ...__FEATURE_CAMEL__Routes.map((route) => route.id),
  ...__FEATURE_CAMEL__FlowNodes.map((node) => node.id),
]);

type FlowEdgeColorVariant = (typeof flowEdgeColorVariants)[number];

type FlowExportLayoutPositions =
  PrototypeFlowLayoutPositions<__FEATURE_PASCAL__FlowTargetId>;

type FlowItem = {
  id: __FEATURE_PASCAL__FlowTargetId;
  kind: "node" | "route";
  node?: __FEATURE_PASCAL__FlowNode;
  route?: __FEATURE_PASCAL__Route;
  width: number;
  height: number;
  x: number;
  y: number;
};

type FlowPoint = {
  x: number;
  y: number;
};

type FlowEdge = {
  arrowPoints: string;
  colorVariant?: FlowEdgeColorVariant;
  from: __FEATURE_PASCAL__FlowTargetId;
  id: string;
  kind?: __FEATURE_PASCAL__Transition["kind"];
  label: string;
  labelX: number;
  labelY: number;
  points: string;
  to: __FEATURE_PASCAL__FlowTargetId;
  trigger: string;
};

function getFlowExportStorageKey() {
  return getPrototypeFlowLayoutStorageKey(__FEATURE_CAMEL__Meta.id);
}

function readStoredFlowExportLayoutPositions(): FlowExportLayoutPositions {
  return readPrototypeFlowLayoutPositions(
    getFlowExportStorageKey(),
    flowExportNodeIds,
  );
}

function getFallbackPosition(index: number) {
  return {
    x: (index % 3) * 560,
    y: Math.floor(index / 3) * 980,
  };
}

function getFlowNodeSize(node: __FEATURE_PASCAL__FlowNode) {
  if (node.shape === "decision") {
    return {
      height: decisionNodeSize,
      width: decisionNodeSize,
    };
  }

  return {
    height: stateNodeHeight,
    width: stateNodeWidth,
  };
}

function getItems(layoutPositions: FlowExportLayoutPositions): FlowItem[] {
  return [
    ...__FEATURE_CAMEL__Routes.map((route, index) => {
      const position =
        layoutPositions[route.id] ?? route.flowPosition ?? getFallbackPosition(index);

      return {
        height: routeHeight,
        id: route.id,
        kind: "route" as const,
        route,
        width: routeWidth,
        x: position.x,
        y: position.y,
      };
    }),
    ...__FEATURE_CAMEL__FlowNodes.map((node, index) => {
      const size = getFlowNodeSize(node);
      const position =
        layoutPositions[node.id] ??
        node.flowPosition ??
        getFallbackPosition(index + __FEATURE_CAMEL__Routes.length);

      return {
        height: size.height,
        id: node.id,
        kind: "node" as const,
        node,
        width: size.width,
        x: position.x,
        y: position.y,
      };
    }),
  ];
}

function getCanvas(items: FlowItem[]) {
  const minX = Math.min(...items.map((item) => item.x));
  const minY = Math.min(...items.map((item) => item.y));
  const maxX = Math.max(...items.map((item) => item.x + item.width));
  const maxY = Math.max(...items.map((item) => item.y + item.height));

  return {
    height: maxY - minY + padding * 2,
    offsetX: padding - minX,
    offsetY: padding - minY,
    width: maxX - minX + padding * 2,
  };
}

function compactPoints(points: FlowPoint[]) {
  return points.filter((point, index) => {
    const previousPoint = points[index - 1];

    return (
      !previousPoint ||
      point.x !== previousPoint.x ||
      point.y !== previousPoint.y
    );
  });
}

function getRoundedPointString(points: FlowPoint[]) {
  return points
    .map((point) => `${Math.round(point.x)},${Math.round(point.y)}`)
    .join(" ");
}

function getArrowPoints(points: FlowPoint[]) {
  const pointList = compactPoints(points);
  const tip = pointList[pointList.length - 1];
  const previous = [...pointList]
    .reverse()
    .find((point) => point.x !== tip?.x || point.y !== tip?.y);

  if (!tip || !previous) {
    return "";
  }

  const dx = tip.x - previous.x;
  const dy = tip.y - previous.y;
  const length = Math.hypot(dx, dy);

  if (length <= 0) {
    return "";
  }

  const ux = dx / length;
  const uy = dy / length;
  const baseCenter = {
    x: tip.x - ux * flowArrowLength,
    y: tip.y - uy * flowArrowLength,
  };
  const normal = {
    x: -uy,
    y: ux,
  };

  return getRoundedPointString([
    tip,
    {
      x: baseCenter.x + normal.x * flowArrowHalfWidth,
      y: baseCenter.y + normal.y * flowArrowHalfWidth,
    },
    {
      x: baseCenter.x - normal.x * flowArrowHalfWidth,
      y: baseCenter.y - normal.y * flowArrowHalfWidth,
    },
  ]);
}

function getItemCenter(item: FlowItem) {
  return {
    x: item.x + item.width / 2,
    y: item.y + item.height / 2,
  };
}

function getBoundaryPoint(item: FlowItem, target: FlowItem) {
  const center = getItemCenter(item);
  const targetCenter = getItemCenter(target);
  const dx = targetCenter.x - center.x;
  const dy = targetCenter.y - center.y;

  if (Math.abs(dx) >= Math.abs(dy)) {
    return {
      x: dx >= 0 ? item.x + item.width : item.x,
      y: center.y,
    };
  }

  return {
    x: center.x,
    y: dy >= 0 ? item.y + item.height : item.y,
  };
}

function getTransitionSourcePoint(
  transition: __FEATURE_PASCAL__Transition,
  source: FlowItem,
  target: FlowItem,
) {
  if (
    transition.sourceAnchor &&
    Number.isFinite(transition.sourceAnchor.x) &&
    Number.isFinite(transition.sourceAnchor.y)
  ) {
    return {
      x: source.x + source.width * transition.sourceAnchor.x,
      y: source.y + source.height * transition.sourceAnchor.y,
    };
  }

  return getBoundaryPoint(source, target);
}

function createPolylinePoints(
  transition: __FEATURE_PASCAL__Transition,
  source: FlowItem,
  target: FlowItem,
) {
  const start = getTransitionSourcePoint(transition, source, target);
  const end = getBoundaryPoint(target, source);
  const horizontal = Math.abs(end.x - start.x) >= Math.abs(end.y - start.y);

  return compactPoints(
    horizontal
      ? [
          start,
          { x: start.x + (end.x - start.x) / 2, y: start.y },
          { x: start.x + (end.x - start.x) / 2, y: end.y },
          end,
        ]
      : [
          start,
          { x: start.x, y: start.y + (end.y - start.y) / 2 },
          { x: end.x, y: start.y + (end.y - start.y) / 2 },
          end,
        ],
  );
}

function getFlowEdges(
  itemMap: Map<__FEATURE_PASCAL__FlowTargetId, FlowItem>,
): FlowEdge[] {
  return __FEATURE_CAMEL__Transitions.flatMap((transition, index) => {
    if (transition.flowLine !== "key") {
      return [];
    }

    const source = itemMap.get(transition.from);
    const target = itemMap.get(transition.to);

    if (!source || !target) {
      return [];
    }

    const pointList = createPolylinePoints(transition, source, target);
    const firstPoint = pointList[0] ?? { x: 0, y: 0 };
    const lastPoint = pointList[pointList.length - 1] ?? firstPoint;

    return [
      {
        arrowPoints: getArrowPoints(pointList),
        colorVariant: flowEdgeColorVariants[index % flowEdgeColorVariants.length],
        from: transition.from,
        id: `${transition.from}-${transition.to}-${index}`,
        kind: transition.kind,
        label: transition.label,
        labelX: firstPoint.x + (lastPoint.x - firstPoint.x) / 2,
        labelY: firstPoint.y + (lastPoint.y - firstPoint.y) / 2,
        points: getRoundedPointString(pointList),
        to: transition.to,
        trigger: transition.trigger,
      },
    ];
  });
}

function getEdgeLabelPrefix(edge: FlowEdge) {
  return edge.kind === "condition" ? "Condition" : "Trigger";
}

export function __FEATURE_PASCAL__FlowExport() {
  const [layoutPositions, setLayoutPositions] = useState(() =>
    readStoredFlowExportLayoutPositions(),
  );
  const items = useMemo(() => getItems(layoutPositions), [layoutPositions]);
  const canvas = getCanvas(items);
  const itemMap = new Map(
    items.map((item) => [
      item.id,
      {
        ...item,
        x: item.x + canvas.offsetX,
        y: item.y + canvas.offsetY,
      },
    ]),
  );
  const edges = getFlowEdges(itemMap);

  useEffect(() => {
    const updateLayoutPositions = () => {
      setLayoutPositions(readStoredFlowExportLayoutPositions());
    };
    const handleStorage = (event: StorageEvent) => {
      if (!event.key || event.key === getFlowExportStorageKey()) {
        updateLayoutPositions();
      }
    };
    const handleVisibilityChange = () => {
      if (document.visibilityState === "visible") {
        updateLayoutPositions();
      }
    };

    updateLayoutPositions();
    window.addEventListener("storage", handleStorage);
    window.addEventListener("focus", updateLayoutPositions);
    document.addEventListener("visibilitychange", handleVisibilityChange);

    return () => {
      window.removeEventListener("storage", handleStorage);
      window.removeEventListener("focus", updateLayoutPositions);
      document.removeEventListener("visibilitychange", handleVisibilityChange);
    };
  }, []);

  return (
    <section
      className="__FEATURE_CSS_CLASS__-flow-export"
      data-component="__FEATURE_KEBAB__-flow"
      data-layout-source={
        Object.keys(layoutPositions).length > 0 ? "saved" : "metadata"
      }
      style={{
        ["--prototype-flow-height" as string]: `${canvas.height}px`,
        ["--prototype-flow-route-header-height" as string]: `${routeHeaderHeight}px`,
        ["--prototype-flow-route-preview-height" as string]: `${routePreviewHeight}px`,
        ["--prototype-flow-route-preview-width" as string]: `${routePreviewWidth}px`,
        ["--prototype-flow-width" as string]: `${canvas.width}px`,
      }}
    >
      <svg
        aria-hidden="true"
        className="__FEATURE_CSS_CLASS__-flow-export__lines"
        height={canvas.height}
        viewBox={`0 0 ${canvas.width} ${canvas.height}`}
        width={canvas.width}
      >
        {edges.map((edge) => (
          <g key={edge.id}>
            <polyline data-flow-color={edge.colorVariant} points={edge.points} />
            {edge.arrowPoints ? (
              <polygon data-flow-color={edge.colorVariant} points={edge.arrowPoints} />
            ) : null}
          </g>
        ))}
      </svg>

      {edges.map((edge) => (
        <span
          className="__FEATURE_CSS_CLASS__-flow-export__edge-label"
          data-flow-color={edge.colorVariant}
          key={`${edge.id}-label`}
          style={{
            ["--prototype-flow-label-x" as string]: `${edge.labelX}px`,
            ["--prototype-flow-label-y" as string]: `${edge.labelY}px`,
          }}
          title={edge.trigger}
        >
          <span data-figma-text-auto-width="true">{getEdgeLabelPrefix(edge)}</span>
          <strong data-figma-text-auto-width="true">{edge.label}</strong>
        </span>
      ))}

      {items.map((item) => {
        const placed = itemMap.get(item.id);
        if (!placed) return null;

        return (
          <article
            className="__FEATURE_CSS_CLASS__-flow-export__item"
            data-kind={item.kind}
            data-shape={item.node?.shape}
            data-tone={item.node?.tone}
            key={item.id}
            style={{
              ["--prototype-flow-item-height" as string]: `${item.height}px`,
              ["--prototype-flow-item-width" as string]: `${item.width}px`,
              ["--prototype-flow-item-x" as string]: `${placed.x}px`,
              ["--prototype-flow-item-y" as string]: `${placed.y}px`,
            }}
          >
            {item.route ? (
              <>
                <header className="__FEATURE_CSS_CLASS__-flow-export__route-header">
                  <div>
                    <span>{item.route.flowGroup ?? item.route.navigationId}</span>
                    <h2>{item.route.title}</h2>
                  </div>
                  <code>{item.route.id}</code>
                </header>
                <div className="__FEATURE_CSS_CLASS__-flow-export__route-preview">
                  <__FEATURE_PASCAL__
                    initialRouteId={item.route.id}
                    isFlowPreview
                  />
                </div>
              </>
            ) : null}
            {item.node ? (
              <div className="__FEATURE_CSS_CLASS__-flow-export__node-surface">
                <div className="__FEATURE_CSS_CLASS__-flow-export__node-copy">
                  <span>{item.node.flowGroup ?? item.node.shape}</span>
                  <h2>{item.node.title}</h2>
                  <p>{item.node.description}</p>
                </div>
              </div>
            ) : null}
          </article>
        );
      })}
    </section>
  );
}
