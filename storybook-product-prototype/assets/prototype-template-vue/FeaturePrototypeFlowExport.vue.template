<script setup lang="ts">
import { computed, onBeforeUnmount, onMounted, ref } from "vue";

import {
  getPrototypeFlowLayoutStorageKey,
  getPrototypeFlowLayoutViewportSignature,
  readPrototypeFlowLayoutPositions,
  type PrototypeFlowLayoutPositions,
} from "../prototypeFlowLayout";
import "./__FEATURE_KEBAB__.css";
import __FEATURE_PASCAL__ from "./__FEATURE_PASCAL__.vue";
import {
  __FEATURE_CAMEL__Flow,
  __FEATURE_CAMEL__FlowNodes,
  __FEATURE_CAMEL__Routes,
  __FEATURE_CAMEL__Transitions,
  type __FEATURE_PASCAL__FlowNode,
  type __FEATURE_PASCAL__FlowTargetId,
  type __FEATURE_PASCAL__Route,
  type __FEATURE_PASCAL__Transition,
} from "./__FEATURE_CAMEL__Flow";
import { __FEATURE_CAMEL__Meta } from "./__FEATURE_CAMEL__Meta";

// Preview size comes from the flow contract at runtime; hand-edits to
// Flow.viewport apply without re-scaffolding. Absent viewport means phone.
const flowViewport = __FEATURE_CAMEL__Flow.viewport ?? {
  formFactor: "phone" as const,
  height: 812,
  width: 375,
};
const routeHeaderHeight = 64;
const routeFrameSize = 2;
const decisionNodeSize = 220;
const stateNodeWidth = 308;
const stateNodeHeight = 124;
const padding = 96;
const flowArrowLength = 14;
const flowArrowHalfWidth = 5;
const flowEdgeColorVariants = [
  "primary",
  "secondary",
  "tertiary",
  "quaternary",
] as const;
const flowExportNodeIds = new Set<__FEATURE_PASCAL__FlowTargetId>([
  ...__FEATURE_CAMEL__Routes.map((route) => route.id),
  ...__FEATURE_CAMEL__FlowNodes.map((node) => node.id),
]);

type FlowEdgeColorVariant = (typeof flowEdgeColorVariants)[number];

type FlowExportLayoutPositions =
  PrototypeFlowLayoutPositions<__FEATURE_PASCAL__FlowTargetId>;

type FlowItem = {
  id: __FEATURE_PASCAL__FlowTargetId;
  kind: "node" | "route";
  node?: __FEATURE_PASCAL__FlowNode;
  route?: __FEATURE_PASCAL__Route;
  width: number;
  height: number;
  x: number;
  y: number;
};

type FlowPoint = {
  x: number;
  y: number;
};

type FlowEdge = {
  arrowPoints: string;
  colorVariant?: FlowEdgeColorVariant;
  from: __FEATURE_PASCAL__FlowTargetId;
  id: string;
  kind?: __FEATURE_PASCAL__Transition["kind"];
  label: string;
  labelX: number;
  labelY: number;
  points: string;
  to: __FEATURE_PASCAL__FlowTargetId;
  trigger: string;
};

function getFlowExportStorageKey() {
  return getPrototypeFlowLayoutStorageKey(__FEATURE_CAMEL__Meta.id);
}

function readStoredFlowExportLayoutPositions(): FlowExportLayoutPositions {
  return readPrototypeFlowLayoutPositions(
    getFlowExportStorageKey(),
    flowExportNodeIds,
    getPrototypeFlowLayoutViewportSignature(flowViewport),
  );
}

function getRoutePreviewSize(route: __FEATURE_PASCAL__Route) {
  return {
    height: route.viewport?.height ?? flowViewport.height,
    width: route.viewport?.width ?? flowViewport.width,
  };
}

function getRouteFrameSize(route: __FEATURE_PASCAL__Route) {
  const preview = getRoutePreviewSize(route);

  return {
    height: routeHeaderHeight + preview.height + routeFrameSize,
    width: preview.width + routeFrameSize,
  };
}

const fallbackRouteFrame = {
  height: routeHeaderHeight + flowViewport.height + routeFrameSize,
  width: flowViewport.width + routeFrameSize,
};
// Derived gutters reproduce the pre-viewport 560x980 pitch exactly at phone.
const fallbackColumnPitch = fallbackRouteFrame.width + 183;
const fallbackRowPitch = fallbackRouteFrame.height + 102;
// Frames this wide would overlap in the 3-column grid; use one row per flowGroup.
const wideFallbackThreshold = 900;
const wideFallbackGap = 160;

function getFallbackPosition(index: number) {
  return {
    x: (index % 3) * fallbackColumnPitch,
    y: Math.floor(index / 3) * fallbackRowPitch,
  };
}

function getWideFallbackPositions() {
  const positions = new Map<
    __FEATURE_PASCAL__FlowTargetId,
    { x: number; y: number }
  >();
  const groupOrder: string[] = [];
  const groupColumns = new Map<string, number>();

  for (const entry of [...__FEATURE_CAMEL__Routes, ...__FEATURE_CAMEL__FlowNodes]) {
    const group = entry.flowGroup ?? "flow";
    if (!groupColumns.has(group)) {
      groupColumns.set(group, 0);
      groupOrder.push(group);
    }
    const column = groupColumns.get(group) ?? 0;
    groupColumns.set(group, column + 1);
    positions.set(entry.id, {
      x: column * (fallbackRouteFrame.width + wideFallbackGap),
      y: groupOrder.indexOf(group) * (fallbackRouteFrame.height + wideFallbackGap),
    });
  }

  return positions;
}

function getFlowNodeSize(node: __FEATURE_PASCAL__FlowNode) {
  if (node.shape === "decision") {
    return {
      height: decisionNodeSize,
      width: decisionNodeSize,
    };
  }

  return {
    height: stateNodeHeight,
    width: stateNodeWidth,
  };
}

function getItems(layoutPositions: FlowExportLayoutPositions): FlowItem[] {
  const wideFallbackPositions =
    fallbackRouteFrame.width >= wideFallbackThreshold
      ? getWideFallbackPositions()
      : null;

  return [
    ...__FEATURE_CAMEL__Routes.map((route, index) => {
      const frame = getRouteFrameSize(route);
      const position =
        layoutPositions[route.id] ??
        route.flowPosition ??
        wideFallbackPositions?.get(route.id) ??
        getFallbackPosition(index);

      return {
        height: frame.height,
        id: route.id,
        kind: "route" as const,
        route,
        width: frame.width,
        x: position.x,
        y: position.y,
      };
    }),
    ...__FEATURE_CAMEL__FlowNodes.map((node, index) => {
      const size = getFlowNodeSize(node);
      // Widen node.id so an empty FlowNodeIds tuple (id type `never`) does not
      // collapse the position chain to `never` before nodes are added.
      const position =
        layoutPositions[node.id as __FEATURE_PASCAL__FlowTargetId] ??
        node.flowPosition ??
        wideFallbackPositions?.get(node.id) ??
        getFallbackPosition(index + __FEATURE_CAMEL__Routes.length);

      return {
        height: size.height,
        id: node.id,
        kind: "node" as const,
        node,
        width: size.width,
        x: position.x,
        y: position.y,
      };
    }),
  ];
}

function getCanvas(items: FlowItem[]) {
  const minX = Math.min(...items.map((item) => item.x));
  const minY = Math.min(...items.map((item) => item.y));
  const maxX = Math.max(...items.map((item) => item.x + item.width));
  const maxY = Math.max(...items.map((item) => item.y + item.height));

  return {
    height: maxY - minY + padding * 2,
    offsetX: padding - minX,
    offsetY: padding - minY,
    width: maxX - minX + padding * 2,
  };
}

function compactPoints(points: FlowPoint[]) {
  return points.filter((point, index) => {
    const previousPoint = points[index - 1];

    return (
      !previousPoint ||
      point.x !== previousPoint.x ||
      point.y !== previousPoint.y
    );
  });
}

function getRoundedPointString(points: FlowPoint[]) {
  return points
    .map((point) => `${Math.round(point.x)},${Math.round(point.y)}`)
    .join(" ");
}

function getArrowPoints(points: FlowPoint[]) {
  const pointList = compactPoints(points);
  const tip = pointList[pointList.length - 1];
  const previous = [...pointList]
    .reverse()
    .find((point) => point.x !== tip?.x || point.y !== tip?.y);

  if (!tip || !previous) {
    return "";
  }

  const dx = tip.x - previous.x;
  const dy = tip.y - previous.y;
  const length = Math.hypot(dx, dy);

  if (length <= 0) {
    return "";
  }

  const ux = dx / length;
  const uy = dy / length;
  const baseCenter = {
    x: tip.x - ux * flowArrowLength,
    y: tip.y - uy * flowArrowLength,
  };
  const normal = {
    x: -uy,
    y: ux,
  };

  return getRoundedPointString([
    tip,
    {
      x: baseCenter.x + normal.x * flowArrowHalfWidth,
      y: baseCenter.y + normal.y * flowArrowHalfWidth,
    },
    {
      x: baseCenter.x - normal.x * flowArrowHalfWidth,
      y: baseCenter.y - normal.y * flowArrowHalfWidth,
    },
  ]);
}

function getItemCenter(item: FlowItem) {
  return {
    x: item.x + item.width / 2,
    y: item.y + item.height / 2,
  };
}

function getBoundaryPoint(item: FlowItem, target: FlowItem) {
  const center = getItemCenter(item);
  const targetCenter = getItemCenter(target);
  const dx = targetCenter.x - center.x;
  const dy = targetCenter.y - center.y;

  if (Math.abs(dx) >= Math.abs(dy)) {
    return {
      x: dx >= 0 ? item.x + item.width : item.x,
      y: center.y,
    };
  }

  return {
    x: center.x,
    y: dy >= 0 ? item.y + item.height : item.y,
  };
}

function getTransitionSourcePoint(
  transition: __FEATURE_PASCAL__Transition,
  source: FlowItem,
  target: FlowItem,
) {
  if (
    transition.sourceAnchor &&
    Number.isFinite(transition.sourceAnchor.x) &&
    Number.isFinite(transition.sourceAnchor.y)
  ) {
    return {
      x: source.x + source.width * transition.sourceAnchor.x,
      y: source.y + source.height * transition.sourceAnchor.y,
    };
  }

  return getBoundaryPoint(source, target);
}

function createPolylinePoints(
  transition: __FEATURE_PASCAL__Transition,
  source: FlowItem,
  target: FlowItem,
  laneOffset: number,
) {
  const start = getTransitionSourcePoint(transition, source, target);
  const end = getBoundaryPoint(target, source);
  const horizontal = Math.abs(end.x - start.x) >= Math.abs(end.y - start.y);

  return compactPoints(
    horizontal
      ? [
          start,
          { x: start.x + (end.x - start.x) / 2 + laneOffset, y: start.y },
          { x: start.x + (end.x - start.x) / 2 + laneOffset, y: end.y },
          end,
        ]
      : [
          start,
          { x: start.x, y: start.y + (end.y - start.y) / 2 + laneOffset },
          { x: end.x, y: start.y + (end.y - start.y) / 2 + laneOffset },
          end,
        ],
  );
}

// Distance between parallel edges that connect the same pair of items, so
// multiple transitions (including reverse directions) stay readable.
const flowEdgeLaneGap = 28;

function getFlowEdgeLaneKey(transition: __FEATURE_PASCAL__Transition) {
  return [transition.from, transition.to].sort().join("~");
}

function getFlowEdges(
  itemMap: Map<__FEATURE_PASCAL__FlowTargetId, FlowItem>,
): FlowEdge[] {
  const keyTransitions = __FEATURE_CAMEL__Transitions.filter(
    (transition) => transition.flowLine === "key",
  );
  const laneCounts = new Map<string, number>();
  for (const transition of keyTransitions) {
    const laneKey = getFlowEdgeLaneKey(transition);
    laneCounts.set(laneKey, (laneCounts.get(laneKey) ?? 0) + 1);
  }
  const laneSeen = new Map<string, number>();

  return keyTransitions.flatMap((transition, index) => {
    const source = itemMap.get(transition.from);
    const target = itemMap.get(transition.to);

    if (!source || !target) {
      return [];
    }

    const laneKey = getFlowEdgeLaneKey(transition);
    const laneCount = laneCounts.get(laneKey) ?? 1;
    const laneIndex = laneSeen.get(laneKey) ?? 0;
    laneSeen.set(laneKey, laneIndex + 1);
    const laneOffset = (laneIndex - (laneCount - 1) / 2) * flowEdgeLaneGap;

    const pointList = createPolylinePoints(transition, source, target, laneOffset);
    // Anchor the label to the middle segment so it sits on the drawn line
    // even when the lane offset shifts the path.
    const midStart = pointList[Math.floor((pointList.length - 1) / 2)] ?? {
      x: 0,
      y: 0,
    };
    const midEnd = pointList[Math.ceil((pointList.length - 1) / 2)] ?? midStart;

    return [
      {
        arrowPoints: getArrowPoints(pointList),
        colorVariant: flowEdgeColorVariants[index % flowEdgeColorVariants.length],
        from: transition.from,
        id: `${transition.from}-${transition.to}-${index}`,
        kind: transition.kind,
        label: transition.label,
        labelX: midStart.x + (midEnd.x - midStart.x) / 2,
        labelY: midStart.y + (midEnd.y - midStart.y) / 2,
        points: getRoundedPointString(pointList),
        to: transition.to,
        trigger: transition.trigger,
      },
    ];
  });
}

function getEdgeLabelPrefix(edge: FlowEdge) {
  return edge.kind === "condition" ? "Condition" : "Trigger";
}

const layoutPositions = ref<FlowExportLayoutPositions>(
  readStoredFlowExportLayoutPositions(),
);
const items = computed(() => getItems(layoutPositions.value));
const canvas = computed(() => getCanvas(items.value));
const itemMap = computed(
  () =>
    new Map(
      items.value.map((item) => [
        item.id,
        {
          ...item,
          x: item.x + canvas.value.offsetX,
          y: item.y + canvas.value.offsetY,
        },
      ]),
    ),
);
const edges = computed(() => getFlowEdges(itemMap.value));
const layoutSource = computed(() =>
  Object.keys(layoutPositions.value).length > 0 ? "saved" : "metadata",
);

function updateLayoutPositions() {
  layoutPositions.value = readStoredFlowExportLayoutPositions();
}

function handleStorage(event: StorageEvent) {
  if (!event.key || event.key === getFlowExportStorageKey()) {
    updateLayoutPositions();
  }
}

function handleVisibilityChange() {
  if (document.visibilityState === "visible") {
    updateLayoutPositions();
  }
}

onMounted(() => {
  updateLayoutPositions();
  window.addEventListener("storage", handleStorage);
  window.addEventListener("focus", updateLayoutPositions);
  document.addEventListener("visibilitychange", handleVisibilityChange);
});

onBeforeUnmount(() => {
  window.removeEventListener("storage", handleStorage);
  window.removeEventListener("focus", updateLayoutPositions);
  document.removeEventListener("visibilitychange", handleVisibilityChange);
});
</script>

<template>
  <section
    class="__FEATURE_CSS_CLASS__-flow-export"
    data-component="__FEATURE_KEBAB__-flow"
    :data-layout-source="layoutSource"
    :style="{
      '--prototype-flow-height': `${canvas.height}px`,
      '--prototype-flow-route-header-height': `${routeHeaderHeight}px`,
      '--prototype-flow-route-preview-height': `${flowViewport.height}px`,
      '--prototype-flow-route-preview-width': `${flowViewport.width}px`,
      '--prototype-flow-width': `${canvas.width}px`,
    }"
  >
    <svg
      aria-hidden="true"
      class="__FEATURE_CSS_CLASS__-flow-export__lines"
      :height="canvas.height"
      :viewBox="`0 0 ${canvas.width} ${canvas.height}`"
      :width="canvas.width"
    >
      <g v-for="edge in edges" :key="edge.id">
        <polyline :data-flow-color="edge.colorVariant" :points="edge.points" />
        <polygon
          v-if="edge.arrowPoints"
          :data-flow-color="edge.colorVariant"
          :points="edge.arrowPoints"
        />
      </g>
    </svg>

    <span
      v-for="edge in edges"
      :key="`${edge.id}-label`"
      class="__FEATURE_CSS_CLASS__-flow-export__edge-label"
      :data-flow-color="edge.colorVariant"
      :style="{
        '--prototype-flow-label-x': `${edge.labelX}px`,
        '--prototype-flow-label-y': `${edge.labelY}px`,
      }"
      :title="edge.trigger"
    >
      <span data-figma-text-auto-width="true">{{ getEdgeLabelPrefix(edge) }}</span>
      <strong data-figma-text-auto-width="true">{{ edge.label }}</strong>
    </span>

    <template v-for="item in items" :key="item.id">
      <article
        v-if="itemMap.get(item.id)"
        class="__FEATURE_CSS_CLASS__-flow-export__item"
        :data-kind="item.kind"
        :data-shape="item.node?.shape"
        :data-tone="item.node?.tone"
        :style="{
          '--prototype-flow-item-height': `${item.height}px`,
          '--prototype-flow-item-width': `${item.width}px`,
          '--prototype-flow-item-x': `${itemMap.get(item.id)!.x}px`,
          '--prototype-flow-item-y': `${itemMap.get(item.id)!.y}px`,
          ...(item.route
            ? {
                '--prototype-flow-route-preview-height': `${getRoutePreviewSize(item.route).height}px`,
                '--prototype-flow-route-preview-width': `${getRoutePreviewSize(item.route).width}px`,
              }
            : {}),
        }"
      >
        <template v-if="item.route">
          <header class="__FEATURE_CSS_CLASS__-flow-export__route-header">
            <div>
              <span>{{ item.route.flowGroup ?? item.route.navigationId }}</span>
              <h2>{{ item.route.title }}</h2>
            </div>
            <span
              class="__FEATURE_CSS_CLASS__-flow-export__route-viewport"
              data-figma-text-auto-width="true"
            >
              {{ flowViewport.formFactor }} · {{ getRoutePreviewSize(item.route).width }}x{{ getRoutePreviewSize(item.route).height }}
            </span>
            <code>{{ item.route.id }}</code>
          </header>
          <div class="__FEATURE_CSS_CLASS__-flow-export__route-preview">
            <__FEATURE_PASCAL__
              :initialRouteId="item.route.id"
              :isFlowPreview="true"
            />
          </div>
        </template>
        <div
          v-if="item.node"
          class="__FEATURE_CSS_CLASS__-flow-export__node-surface"
        >
          <div class="__FEATURE_CSS_CLASS__-flow-export__node-copy">
            <span>{{ item.node.flowGroup ?? item.node.shape }}</span>
            <h2>{{ item.node.title }}</h2>
            <p>{{ item.node.description }}</p>
          </div>
        </div>
      </article>
    </template>
  </section>
</template>
